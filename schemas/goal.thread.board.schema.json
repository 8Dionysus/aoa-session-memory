{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "aoa-session-memory://schemas/goal.thread.board.public.v1",
  "title": "aoa-session-memory exact Goal/thread public board",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "publication_schema_version",
    "artifact_type",
    "generated_at",
    "ok",
    "state",
    "currentness",
    "publication_state",
    "goal_ref",
    "master_thread_id",
    "exact_binding",
    "source",
    "owner_read",
    "snapshot",
    "pagination",
    "ordering",
    "page",
    "snapshot_digest",
    "page_digest",
    "source_item_count",
    "item_count",
    "total_item_count",
    "relation_state",
    "relations",
    "branch",
    "items",
    "diagnostics",
    "omissions",
    "privacy",
    "claim_limit"
  ],
  "properties": {
    "schema_version": {"const": "aoa_session_memory_goal_thread_board_v1"},
    "publication_schema_version": {"const": "aoa_session_memory_goal_thread_board_public_v1"},
    "artifact_type": {"const": "goal_thread_board_projection"},
    "generated_at": {"type": "string", "minLength": 1},
    "ok": {"type": "boolean"},
    "state": {"$ref": "#/$defs/state"},
    "currentness": {"$ref": "#/$defs/state"},
    "publication_state": {"$ref": "#/$defs/publicationState"},
    "goal_ref": {"type": "string", "minLength": 1},
    "master_thread_id": {"type": "string", "minLength": 1},
    "exact_binding": {"$ref": "#/$defs/exactBinding"},
    "source": {"$ref": "#/$defs/source"},
    "owner_read": {"$ref": "#/$defs/ownerRead"},
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "pagination": {"$ref": "#/$defs/pagination"},
    "ordering": {"$ref": "#/$defs/ordering"},
    "page": {"$ref": "#/$defs/page"},
    "snapshot_digest": {"$ref": "#/$defs/digest"},
    "page_digest": {"$ref": "#/$defs/digest"},
    "source_item_count": {"type": "integer", "minimum": 0},
    "item_count": {"type": "integer", "minimum": 0},
    "total_item_count": {"type": "integer", "minimum": 0},
    "relation_state": {"$ref": "#/$defs/relationState"},
    "relations": {"type": "array", "items": {"$ref": "#/$defs/relation"}},
    "branch": {"$ref": "#/$defs/branch"},
    "items": {"type": "array", "items": {"$ref": "#/$defs/item"}},
    "diagnostics": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "omissions": {"$ref": "#/$defs/omissions"},
    "privacy": {"$ref": "#/$defs/privacy"},
    "claim_limit": {"type": "string", "minLength": 1}
  },
  "$defs": {
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "state": {
      "enum": ["current", "missing", "unknown", "stale", "deferred", "invalid"]
    },
    "publicationState": {
      "enum": ["bound", "current", "missing", "unknown", "stale", "deferred", "invalid"]
    },
    "ownerState": {
      "enum": ["bound", "missing", "unknown", "stale", "deferred", "invalid"]
    },
    "currentness": {
      "enum": ["current_at_read", "current", "missing", "unknown", "stale", "deferred", "invalid"]
    },
    "safeRefState": {
      "enum": ["available", "opaque"]
    },
    "exactBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["goal_ref", "master_thread_id", "equal", "query_mode"],
      "properties": {
        "goal_ref": {"type": "string", "minLength": 1},
        "master_thread_id": {"type": "string", "minLength": 1},
        "equal": {"type": "boolean"},
        "query_mode": {"const": "exact_only"}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": true
    },
    "catalogWatermark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "registry_digest",
        "source_set_digest",
        "session_count",
        "goal_lifecycle_count",
        "coverage",
        "live_tail",
        "max_updated_at",
        "max_raw_line_count"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "complete_session_index_set_v1"},
        "registry_digest": {"type": ["string", "null"]},
        "source_set_digest": {"$ref": "#/$defs/digest"},
        "session_count": {"type": "integer", "minimum": 0},
        "goal_lifecycle_count": {"type": "integer", "minimum": 0},
        "coverage": {"enum": ["complete", "incomplete"]},
        "live_tail": {"$ref": "#/$defs/liveTail"},
        "max_updated_at": {"type": "string"},
        "max_raw_line_count": {"type": "integer", "minimum": 0}
      }
    },
    "liveTail": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "coverage", "diagnostics"],
      "properties": {
        "state": {"enum": ["current", "ahead", "unstable", "unknown", "not_observed"]},
        "coverage": {"const": "stable_projection_watermark"},
        "diagnostics": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "sourceWatermark": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "kind",
        "catalog",
        "owner_observation_digest",
        "owner_currentness",
        "item_count",
        "relation_count",
        "coverage"
      ],
      "properties": {
        "schema_version": {"const": 1},
        "kind": {"const": "goal_thread_board_source_watermark_v1"},
        "catalog": {"$ref": "#/$defs/catalogWatermark"},
        "owner_observation_digest": {"$ref": "#/$defs/digest"},
        "owner_currentness": {"$ref": "#/$defs/currentness"},
        "item_count": {"type": "integer", "minimum": 0},
        "relation_count": {"type": "integer", "minimum": 0},
        "coverage": {"enum": ["complete", "incomplete"]}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "ref", "catalog_ref", "generation_identity", "watermark", "currentness"],
      "properties": {
        "owner": {"const": "aoa-session-memory"},
        "ref": {"const": "aoa-session-memory:goal-thread-board"},
        "catalog_ref": {"const": "aoa-session-memory:goal-lifecycles"},
        "generation_identity": {"$ref": "#/$defs/generation"},
        "watermark": {"$ref": "#/$defs/sourceWatermark"},
        "currentness": {"$ref": "#/$defs/state"}
      }
    },
    "ownerSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "methods", "currentness"],
      "properties": {
        "owner": {"const": "codex-app-server"},
        "methods": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "currentness": {"$ref": "#/$defs/currentness"}
      }
    },
    "ownerGoal": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["thread_id", "status", "created_at", "updated_at"],
      "properties": {
        "thread_id": {"type": "string", "minLength": 1},
        "status": {"type": ["string", "null"]},
        "created_at": {"type": ["integer", "null"], "minimum": 0},
        "updated_at": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "ownerThread": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["thread_id", "status"],
      "properties": {
        "thread_id": {"type": "string", "minLength": 1},
        "status": {"type": ["string", "null"]},
        "parentThreadId": {"type": "string", "minLength": 1},
        "parentThreadId_state": {"$ref": "#/$defs/safeRefState"},
        "forkedFromId": {"type": "string", "minLength": 1},
        "forkedFromId_state": {"$ref": "#/$defs/safeRefState"}
      }
    },
    "ownerRead": {
      "type": "object",
      "additionalProperties": false,
      "required": ["owner", "state", "currentness", "source", "goal", "thread", "observation_digest", "diagnostics"],
      "properties": {
        "owner": {"const": "codex-app-server"},
        "state": {"$ref": "#/$defs/ownerState"},
        "currentness": {"$ref": "#/$defs/currentness"},
        "source": {"$ref": "#/$defs/ownerSource"},
        "goal": {"$ref": "#/$defs/ownerGoal"},
        "thread": {"$ref": "#/$defs/ownerThread"},
        "observation_digest": {"$ref": "#/$defs/digest"},
        "diagnostics": {"type": "array", "items": {"type": "string", "minLength": 1}}
      }
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot_ref", "snapshot_digest", "generated_at", "source_watermark", "source_freshness", "projection_freshness", "immutable", "read_attempts", "max_read_attempts", "retry_exhausted", "stable_source"],
      "properties": {
        "snapshot_ref": {"$ref": "#/$defs/digest"},
        "snapshot_digest": {"$ref": "#/$defs/digest"},
        "generated_at": {"type": "string", "minLength": 1},
        "source_watermark": {"$ref": "#/$defs/sourceWatermark"},
        "source_freshness": {"$ref": "#/$defs/state"},
        "projection_freshness": {"$ref": "#/$defs/state"},
        "immutable": {"const": true},
        "read_attempts": {"type": "integer", "minimum": 1},
        "max_read_attempts": {"type": "integer", "minimum": 1},
        "retry_exhausted": {"type": "boolean"},
        "stable_source": {"type": "boolean"}
      }
    },
    "pagination": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "cursor", "next_cursor", "owner_next_cursor", "complete_for_query", "page_size", "supports_immutable_snapshot", "owner_page_complete"],
      "properties": {
        "mode": {"const": "immutable_snapshot"},
        "cursor": {"type": ["string", "null"]},
        "next_cursor": {"type": ["string", "null"]},
        "owner_next_cursor": {"type": ["string", "null"]},
        "complete_for_query": {"type": "boolean"},
        "page_size": {"type": "integer", "minimum": 1},
        "supports_immutable_snapshot": {"const": true},
        "owner_page_complete": {"type": "boolean"}
      }
    },
    "eventOrdering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "kind", "reason"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "kind": {"const": "unavailable"},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "ordering": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "item_order_is_semantic", "event_ordering", "watermark"],
      "properties": {
        "kind": {"const": "source_page_order"},
        "item_order_is_semantic": {"const": false},
        "event_ordering": {"$ref": "#/$defs/eventOrdering"},
        "watermark": {"$ref": "#/$defs/sourceWatermark"}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["offset", "item_count", "page_digest"],
      "properties": {
        "offset": {"type": "integer", "minimum": 0},
        "item_count": {"type": "integer", "minimum": 0},
        "page_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "item_ref",
        "item_id",
        "item_id_state",
        "item_kind",
        "owner_event_kind",
        "owner_item_type",
        "review_state",
        "body_state",
        "order",
        "order_state",
        "goal_ref",
        "thread_id",
        "observed_at",
        "source_ref",
        "evidence_ref",
        "redacted_fields",
        "item_digest"
      ],
      "properties": {
        "item_ref": {"type": "string", "minLength": 1},
        "item_id": {"type": "string", "minLength": 1},
        "item_id_state": {"$ref": "#/$defs/safeRefState"},
        "item_kind": {"enum": ["codex_thread_item_observation", "goal_lifecycle_observation"]},
        "owner_event_kind": {"type": ["string", "null"]},
        "owner_item_type": {"type": ["string", "null"]},
        "review_state": {"const": "reviewed_public_safe"},
        "body_state": {"const": "withheld"},
        "order": {"type": "integer", "minimum": 0},
        "order_state": {"enum": ["owner_page_order", "owner_index_order"]},
        "goal_ref": {"type": "string", "minLength": 1},
        "thread_id": {"type": ["string", "null"]},
        "observed_at": {"type": ["string", "null"]},
        "source_ref": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "minLength": 1},
        "redacted_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "item_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "relationState": {
      "enum": ["complete", "available", "missing", "unknown", "stale", "deferred", "invalid"]
    },
    "relation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relation_ref",
        "relation_kind",
        "from_thread_id",
        "to_thread_id",
        "from_thread_id_state",
        "to_thread_id_state",
        "relation_state",
        "semantic_branch_state",
        "order",
        "source_ref",
        "goal_ref",
        "evidence_ref",
        "redacted_fields",
        "relation_digest"
      ],
      "properties": {
        "relation_ref": {"type": "string", "minLength": 1},
        "relation_kind": {"enum": ["spawn_parent", "history_fork"]},
        "from_thread_id": {"type": "string", "minLength": 1},
        "to_thread_id": {"type": "string", "minLength": 1},
        "from_thread_id_state": {"$ref": "#/$defs/safeRefState"},
        "to_thread_id_state": {"$ref": "#/$defs/safeRefState"},
        "relation_state": {"const": "available"},
        "semantic_branch_state": {"const": "missing"},
        "order": {"type": "integer", "minimum": 0},
        "source_ref": {"type": "string", "minLength": 1},
        "goal_ref": {"type": "string", "minLength": 1},
        "evidence_ref": {"type": "string", "minLength": 1},
        "redacted_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "relation_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "branch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "branch_ref", "lifecycle_state", "reason"],
      "properties": {
        "state": {"$ref": "#/$defs/state"},
        "branch_ref": {"type": ["string", "null"]},
        "lifecycle_state": {"type": ["string", "null"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "omissions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prompt", "transcript_body", "objective", "raw_paths", "private_metadata", "command_text", "tool_arguments", "tool_results", "process_identity", "actor_identity", "model_identity"],
      "properties": {
        "prompt": {"const": true},
        "transcript_body": {"const": true},
        "objective": {"const": true},
        "raw_paths": {"const": true},
        "private_metadata": {"const": true},
        "command_text": {"const": true},
        "tool_arguments": {"const": true},
        "tool_results": {"const": true},
        "process_identity": {"const": true},
        "actor_identity": {"const": true},
        "model_identity": {"const": true}
      }
    },
    "privacy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "allowlisted_fields", "withheld_fields", "prohibited_join_keys", "no_transcript_body", "no_raw_paths", "no_private_metadata", "no_actor_inference"],
      "properties": {
        "scope": {"const": "owner_bounded_public_safe"},
        "allowlisted_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "withheld_fields": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "prohibited_join_keys": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "no_transcript_body": {"const": true},
        "no_raw_paths": {"const": true},
        "no_private_metadata": {"const": true},
        "no_actor_inference": {"const": true}
      }
    }
  }
}
