{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AoA persistent live-tail postings",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_type",
    "session_id",
    "epoch_id",
    "generation_identity",
    "updated_at",
    "processed_bytes",
    "processed_line_count",
    "source_captured_bytes",
    "projection_raw_bytes",
    "projection_raw_line_count",
    "pending_incomplete_bytes",
    "entry_count",
    "entries",
    "token_count",
    "token_postings",
    "privacy",
    "authority"
  ],
  "properties": {
    "schema_version": {"const": 2},
    "artifact_type": {"const": "persistent_live_tail_postings"},
    "session_id": {"type": "string", "minLength": 1},
    "epoch_id": {"type": "string", "pattern": "^[a-f0-9]{24}$"},
    "generation_identity": {
      "type": "object",
      "required": ["generation_id"],
      "properties": {
        "generation_id": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": true
    },
    "updated_at": {"type": "string", "minLength": 1},
    "processed_bytes": {"type": "integer", "minimum": 0},
    "processed_line_count": {"type": "integer", "minimum": 0},
    "source_captured_bytes": {"type": "integer", "minimum": 0},
    "projection_raw_bytes": {"type": "integer", "minimum": 0},
    "projection_raw_line_count": {"type": "integer", "minimum": 0},
    "pending_incomplete_bytes": {"type": "integer", "minimum": 0},
    "entry_count": {"type": "integer", "minimum": 0},
    "entries": {
      "type": "array",
      "items": {"$ref": "#/$defs/posting"}
    },
    "token_count": {"type": "integer", "minimum": 0},
    "token_postings": {
      "type": "object",
      "propertyNames": {"type": "string", "minLength": 2},
      "additionalProperties": {
        "type": "array",
        "items": {"type": "integer", "minimum": 0},
        "uniqueItems": true
      }
    },
    "privacy": {
      "type": "object",
      "required": [
        "raw_text_persisted",
        "reversible_literal_digests_persisted"
      ],
      "properties": {
        "raw_text_persisted": {"const": false},
        "reversible_literal_digests_persisted": {"const": false}
      },
      "additionalProperties": true
    },
    "authority": {
      "const": "derived_navigation_with_typed_refs_raw_capture_is_authority"
    }
  },
  "$defs": {
    "posting": {
      "type": "object",
      "required": [
        "event_id",
        "line",
        "byte_offset",
        "byte_count",
        "event_type",
        "source_type",
        "route_signals",
        "preview",
        "tokens",
        "raw_ref",
        "capture_ref"
      ],
      "properties": {
        "event_id": {"type": "string", "minLength": 1},
        "line": {"type": "integer", "minimum": 1},
        "byte_offset": {"type": "integer", "minimum": 0},
        "byte_count": {"type": "integer", "minimum": 1},
        "event_type": {"type": "string", "minLength": 1},
        "source_type": {"type": "string", "minLength": 1},
        "timestamp": {"type": "string"},
        "family": {"type": "string"},
        "phase": {"type": "string"},
        "actor": {"type": "string"},
        "action": {"type": "string"},
        "outcome": {"type": "string"},
        "correlation_id": {"type": "string"},
        "route_signals": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["layer", "key"],
            "properties": {
              "layer": {"type": "string", "minLength": 1},
              "key": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "preview": {"type": "string"},
        "tokens": {
          "type": "array",
          "items": {"type": "string", "minLength": 2},
          "uniqueItems": true
        },
        "raw_ref": {"type": "string", "pattern": "^raw:line:[1-9][0-9]*$"},
        "capture_ref": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
